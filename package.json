{
  "name": "spring-number-flow",
  "version": "0.1.0",
  "description": "Animated number transitions with spring physics. A pre-configured React wrapper around number-flow.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@number-flow/react": ">=0.4"
  },
  "devDependencies": {
    "@number-flow/react": "^0.4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "react": "^18",
    "react-dom": "^18",
    "typescript": "^5",
    "vite": "^5",
    "vite-plugin-dts": "^3"
  },
  "keywords": ["react", "number-flow", "spring", "animation", "counter", "transition"],
  "author": "Ezekiel Adewumi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaezekiel/spring-number-flow"
  },
  "homepage": "https://aaezekiel.co/notes/spring-number-flow"
}
